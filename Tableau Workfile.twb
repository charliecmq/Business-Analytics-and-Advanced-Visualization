      <table>
        <view>
          <datasources>
            <datasource caption='Select Measure Data (2025 County Health Rankings Data - v4)' name='federated.1qz9ofa0fiab911dn3n370chdfrp' />
          </datasources>
          <datasource-dependencies datasource='federated.1qz9ofa0fiab911dn3n370chdfrp'>
            <column datatype='real' name='[% Households with Broadband Access]' role='measure' type='quantitative' />
            <column datatype='real' name='[% Severe Housing Problems]' role='measure' type='quantitative' />
            <column caption='Z-score: Tech (Broadband)' datatype='real' name='[Calculation_1556672753848358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( AVG([% Households with Broadband Access]) - MIN({FIXED : AVG([% Households with Broadband Access])}) )&#10;/&#10;MIN({FIXED : STDEV([% Households with Broadband Access])})' />
            </column>
            <column caption='Z-Score: Health (Food Index)' datatype='real' name='[Calculation_1556672753963047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( AVG([Food Environment Index]) - MIN({FIXED : AVG([Food Environment Index])}) )&#10;/&#10;MIN({FIXED : STDEV([Food Environment Index])})' />
            </column>
            <column caption='Z-score: Shelter (Housing)' datatype='real' name='[Calculation_1556672754327592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( MIN({FIXED : AVG([% Severe Housing Problems])}) - AVG([% Severe Housing Problems]) )&#10;/&#10;MIN({FIXED : STDEV([% Severe Housing Problems])})' />
            </column>
            <column caption='Is Triple Threat?' datatype='boolean' name='[Calculation_1556672764006441]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Returns TRUE only if all three scores are Negative (Red)&#10;[Calculation_1556672753963047] &lt; 0&#10;AND&#10;[Calculation_1556672754327592] &lt; 0&#10;AND&#10;[Calculation_1556672753848358] &lt; 0' />
            </column>
            <column datatype='string' name='[County]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Food Environment Index]' role='measure' type='quantitative' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[County]' derivation='None' name='[none:County:nk]' pivot='key' type='nominal' />

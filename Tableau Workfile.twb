      <table>
        <view>
          <datasources>
            <datasource caption='Select Measure Data (2025 County Health Rankings Data - v4)' name='federated.1qz9ofa0fiab911dn3n370chdfrp' />
          </datasources>
          <datasource-dependencies datasource='federated.1qz9ofa0fiab911dn3n370chdfrp'>
            <column datatype='real' name='[% Households with Broadband Access]' role='measure' type='quantitative' />
            <column datatype='real' name='[% Severe Housing Problems]' role='measure' type='quantitative' />
            <column datatype='integer' name='[80th Percentile Income]' role='measure' type='quantitative' />
            <column caption='Quadrant Category' datatype='string' name='[Calculation_1556672268541953]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(AVG([% Households with Broadband Access])) &gt;= MIN([Calculation_1556673400094764])&#10;AND ZN(AVG([% Severe Housing Problems])) &lt;= MIN([Calculation_1556673400274989])&#10;THEN &quot;🟢 Balanced Development&quot;&#10;&#10;ELSEIF ZN(AVG([% Households with Broadband Access])) &gt;= MIN([Calculation_1556673400094764])&#10;AND ZN(AVG([% Severe Housing Problems])) &gt; MIN([Calculation_1556673400274989])&#10;THEN &quot;⚖️ Tech ≠ Shelter&quot;&#10;&#10;ELSEIF ZN(AVG([% Households with Broadband Access])) &lt; MIN([Calculation_1556673400094764])&#10;AND ZN(AVG([% Severe Housing Problems])) &gt; MIN([Calculation_1556673400274989])&#10;THEN &quot;🚨 Double Disadvantage&quot;&#10;&#10;ELSE &quot;🔹 Underdeveloped&quot;&#10;END' />
            </column>
            <column caption='National Avg Tech' datatype='real' name='[Calculation_1556672779108394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : AVG( {FIXED [State] : AVG([% Households with Broadband Access])} )}' />
            </column>
            <column caption='National Avg Housing' datatype='real' name='[Calculation_1556672779165739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : AVG( {FIXED [State] : AVG([% Severe Housing Problems])} )}' />
            </column>
            <column caption='Ref Line: National Tech' datatype='real' name='[Calculation_1556673400094764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : AVG( {FIXED [State] : AVG([% Households with Broadband Access])} )}' />
            </column>
            <column caption='Ref Line: National Shelter' datatype='real' name='[Calculation_1556673400274989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : AVG( {FIXED [State] : AVG([% Severe Housing Problems])} )}' />

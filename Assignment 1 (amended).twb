ia&quot; THEN &quot;PA&quot;&#10;WHEN &quot;Rhode Island&quot; THEN &quot;RI&quot;&#10;WHEN &quot;South Carolina&quot; THEN &quot;SC&quot;&#10;WHEN &quot;South Dakota&quot; THEN &quot;SD&quot;&#10;WHEN &quot;Tennessee&quot; THEN &quot;TN&quot;&#10;WHEN &quot;Texas&quot; THEN &quot;TX&quot;&#10;WHEN &quot;Utah&quot; THEN &quot;UT&quot;&#10;WHEN &quot;Vermont&quot; THEN &quot;VT&quot;&#10;WHEN &quot;Virginia&quot; THEN &quot;VA&quot;&#10;WHEN &quot;Washington&quot; THEN &quot;WA&quot;&#10;WHEN &quot;West Virginia&quot; THEN &quot;WV&quot;&#10;WHEN &quot;Wisconsin&quot; THEN &quot;WI&quot;&#10;WHEN &quot;Wyoming&quot; THEN &quot;WY&quot;&#10;END' />
      </column>
      <column caption='Quadrant Category' datatype='string' name='[Calculation_1556672268541953]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ZN(AVG([% Households with Broadband Access])) &gt;= MIN([Calculation_1556673400094764])&#10;AND ZN(AVG([% Severe Housing Problems])) &lt;= MIN([Calculation_1556673400274989])&#10;THEN &quot;🟢 Balanced Development&quot;&#10;&#10;ELSEIF ZN(AVG([% Households with Broadband Access])) &gt;= MIN([Calculation_1556673400094764])&#10;AND ZN(AVG([% Severe Housing Problems])) &gt; MIN([Calculation_1556673400274989])&#10;THEN &quot;⚖️ Tech ≠ Shelter&quot;&#10;&#10;ELSEIF ZN(AVG([% Households with Broadband Access])) &lt; MIN([Calculation_1556673400094764])&#10;AND ZN(AVG([% Severe Housing Problems])) &gt; MIN([Calculation_1556673400274989])&#10;THEN &quot;🚨 Double Disadvantage&quot;&#10;&#10;ELSE &quot;🔹 Underdeveloped&quot;&#10;END' />
      </column>
      <column caption='State Min FEI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1556672276463619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : MIN([Food Environment Index]) }' />
      </column>
      <column caption='State Max FEI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1556672276951044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [State] : MAX([Food Environment Index])}' />
      </column>
      <column caption='FEI Gap' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1556672284975110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1556672276951044] - [Calculation_1556672276463619]' />
      </column>
      <column caption='Z-score: Tech (Broadband)' datatype='real' name='[Calculation_1556672753848358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( AVG([% Households with Broadband Access]) - MIN({FIXED : AVG([% Households with Broadband Access])}) )&#10;/&#10;MIN({FIXED : STDEV([% Households with Broadband Access])})' />
      </column>
      <column caption='Z-Score: Health (Food Index)' datatype='real' name='[Calculation_1556672753963047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( AVG([Food Environment Index]) - MIN({FIXED : AVG([Food Environment Index])}) )&#10;/&#10;MIN({FIXED : STDEV([Food Environment Index])})' />
      </column>
      <column caption='Z-score: Shelter (Housing)' datatype='real' name='[Calculation_1556672754327592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( MIN({FIXED : AVG([% Severe Housing Problems])}) - AVG([% Severe Housing Problems]) )&#10;/&#10;MIN({FIXED : STDEV([% Severe Housing Problems])})' />
      </column>
      <column caption='Is Triple Threat?' datatype='boolean' name='[Calculation_1556672764006441]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Returns TRUE only if all three scores are Negative (Red)&#10;[Calculation_1556672753963047] &lt; 0&#10;AND&#10;[Calculation_1556672754327592] &lt; 0&#10;AND&#10;[Calculation_1556672753848358] &lt; 0' />
      </column>
      <column caption='National Avg Tech' datatype='real' name='[Calculation_1556672779108394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG( {FIXED [State] : AVG([% Households with Broadband Access])} )}' />
      </column>
      <column caption='National Avg Housing' datatype='real' name='[Calculation_1556672779165739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG( {FIXED [State] : AVG([% Severe Housing Problems])} )}' />
      </column>
      <column caption='Ref Line: National Tech' datatype='real' name='[Calculation_1556673400094764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG( {FIXED [State] : AVG([% Households with Broadband Access])} )}' />
      </column>
      <column caption='Ref Line: National Shelter' datatype='real' name='[Calculation_1556673400274989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG( {FIXED [State] : AVG([% Severe Housing Problems])} )}' />
      </column>
